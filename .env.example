# Backend (api-gateway) — переменные окружения. Сервис production-only: без обязательных
# переменных он не стартует (никаких in-memory/mock фолбэков). Обязательные помечены [req].

# [req] Postgres (Railway/Neon). Neon требует TLS (sslmode=require) — см. README.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# [req] Redis (Railway/Upstash). Upstash — rediss:// (TLS).
REDIS_URL=redis://default:pass@host:6379

# [req] ClickHouse (HTTP-интерфейс) для аналитики. Запись best-effort, подключение обязательно.
CLICKHOUSE_URL=https://user:pass@host:8443

# [req] JWT-секрет для подписи токенов.
JWT_SECRET=change-me-in-prod

# [req] Блокчейн-RPC. EVM обязателен; Bitcoin и Solana подключаются, если заданы их адреса.
EVM_RPC_URL=https://sepolia.infura.io/v3/<key>
# BTC_ESPLORA_URL=https://blockstream.info/testnet/api
# SOLANA_RPC_URL=https://api.devnet.solana.com

# [req] KYC/AML — внешние сервисы комплаенса (HTTP). Поведение при сбое — fail-closed.
KYC_PROVIDER_URL=https://kyc.example.com/v1/submit
AML_SCREENING_URL=https://aml.example.com/v1/screen

# [req] Signing-service: удалённый signer по gRPC. Сертификаты генерирует scripts/gen-certs.sh.
# Если SIGNER_TLS_* не заданы — канал plaintext (допустимо только в доверенной приватной сети).
# -- gateway (клиент) --
SIGNER_GRPC_ENDPOINT=https://localhost:50051
# SIGNER_TLS_CLIENT_CERT=certs/client.crt
# SIGNER_TLS_CLIENT_KEY=certs/client.key
# SIGNER_TLS_CA=certs/ca.crt
# SIGNER_TLS_DOMAIN=localhost
# -- signing-service (сервер) --
# SIGNER_MNEMONIC=...                 # seed; в проде — из KMS/secret, не из env
# SIGNER_BIND=0.0.0.0:50051
# SIGNER_TLS_CERT=certs/server.crt
# SIGNER_TLS_KEY=certs/server.key
# SIGNER_TLS_CLIENT_CA=certs/ca.crt

# Block-scanner: период опроса подтверждений исходящих транзакций, сек (деф. 15).
# SCAN_INTERVAL_SECS=15

# CORS: домен фронта на Vercel (иначе permissive для dev).
# CORS_ORIGIN=https://your-app.vercel.app

PORT=8080
